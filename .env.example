# Copy to swarm/.env and swarm/web/.env.local, then fill in your own key.
# A public devnet endpoint works but rate-limits hard; see bench/RESULTS.md.
L1_RPC=https://devnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Set in swarm/web/.env.local to read live chain data instead of the
# in-browser simulation. Leave unset on a hosted deploy.
NEXT_PUBLIC_LIVE=true
